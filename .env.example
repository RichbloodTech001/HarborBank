# PostgreSQL connection string. Keep real values in your deployment secret manager.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/harborbank?schema=public"

# Optional comma-separated administrator emails. Only server-side configuration is trusted.
ADMIN_EMAILS="admin@example.com"
DEFAULT_CURRENCY="USD"
# Set a long random secret used to hash source IP values in audit records.
IP_HASH_SALT="replace-with-a-long-random-value"

# Real-money processing is intentionally not implemented/enabled.
BANKING_MODE="demo"
